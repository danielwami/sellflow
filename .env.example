# Client-side — safe to expose, these ship in the browser bundle.
# Base URL of the Supabase project hosting the two edge functions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Do NOT put these in this file or any .env that ships to the
# client — set them as edge function secrets:
#   supabase secrets set CLAUDE_API_KEY=... SCRAPE_CREATORS_API_KEY=...
#
# CLAUDE_API_KEY=
# SCRAPE_CREATORS_API_KEY=
